# deps
node_modules/
.pnpm-store/

# build output
dist/
build/
.turbo/
*.tsbuildinfo

# env + secrets
.env
.env.*
!.env.example

# local scan output — never commit findings
*-scan.json

# runtime data
data/
artifacts/
*.db
*.sqlite

# logs + coverage
*.log
coverage/
.nyc_output/

# OS + editors
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# local wrangler / docker state
.wrangler/
docker-data/
apps/local/.ci-ollama-models/

# changesets — versioning stays committed, but ignore the local temp state
.changeset/*.tmp.md
