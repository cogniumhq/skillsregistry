# SkillsRegistry Local — example env file.
#
# Copy to `.env` (`cp apps/local/.env.example apps/local/.env`) and fill in
# the required values. Docker Compose auto-loads this file from the same
# directory as `docker-compose.yml`: every `${VAR}` interpolation in the
# compose file resolves against it, AND the `app` service loads it as its
# `env_file`, so every key here reaches `loadConfig()` inside the container
# (#98). `.env` is git-ignored; `.env.example` is the tracked template.
#
# Only `DATABASE_URL` + `ADMIN_TOKEN` are strictly required to boot. Every
# other var has a sensible default in `src/config.ts` — set them only when
# you need to override the default.

# ─── Required ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://skillsregistry:skillsregistry@localhost:5432/skillsregistry
ADMIN_TOKEN=change-me-to-a-long-random-value

# ─── HTTP (defaults shown) ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# ─── Docker Compose host binds (#99) ────────────────────────────────────────
# Compose publishes every port on 127.0.0.1 by default. Set APP_BIND=0.0.0.0
# to serve the node on a LAN (admin/migrate APIs still need ADMIN_TOKEN
# over-network). Leave Postgres / Ollama on loopback — they are only published
# for operator tooling (psql, `ollama pull`).
# APP_BIND=127.0.0.1
# POSTGRES_BIND=127.0.0.1
# OLLAMA_BIND=127.0.0.1
# POSTGRES_PORT=5432
# OLLAMA_PORT=11434
# Postgres password inside the Compose stack. Change it before exposing 5432
# beyond loopback. DATABASE_URL inside the container is derived from it.
# POSTGRES_PASSWORD=skillsregistry

# ─── Postgres pool (defaults shown) ─────────────────────────────────────────
POSTGRES_POOL_MAX=10
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# ─── Artifact storage ───────────────────────────────────────────────────────
# Absolute path. Default: ${cwd}/data/artifacts.
# ARTIFACT_BASE_DIR=/var/lib/skillsregistry/artifacts

# ─── Tenant-budget poller (connected mode only) ─────────────────────────────
# BUDGET_REFRESH_CRON — node-cron schedule for `GET /v1/tenant/budget`. Default 03:00 daily.
# BUDGET_TTL_SECONDS  — KV row TTL. Default 93600 (26h — longer than the daily cadence so a
#                      missed refresh doesn't silently evict the row).
# BUDGET_REFRESH_CRON=0 3 * * *
# BUDGET_TTL_SECONDS=93600

# ─── Embedder — use `ollama`; `upstream` currently fails at boot ────────────
EMBEDDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Upstream (leave unset for air-gap mode) ────────────────────────────────
# All three must be set together, or none.
# MOTHERSHIP_URL=https://api.skillsregistry.net
# MOTHERSHIP_API_KEY=sk_live_...
# TENANT_ID=your-tenant-id
# Upstream search fallback is not implemented by the local node.

# ─── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL — trace|debug|info|warn|error|fatal (default info)
# LOG_FORMAT — json (default; NDJSON for container log collectors) or pretty (dev)
# LOG_REQUEST_ID_HEADER — inbound + echoed header (default X-Request-Id).
#                         Must be valid HTTP header (RFC 7230 tchar, ≤64 chars).
LOG_LEVEL=info
LOG_FORMAT=json
# LOG_REQUEST_ID_HEADER=X-Request-Id

# ─── MCP surface (defaults live in src/config.ts) ───────────────────────────
# MCP_SERVER_NAME=skillsregistry-local
# MCP_SERVER_VERSION=0.1.0
# MCP_CANONICAL_ORIGIN=https://your-node.example.com   # used in discovery descriptor
# MCP_DOCUMENTATION_URL=https://docs.skillsregistry.net
# MCP_OPENAPI_URL=https://your-node.example.com/openapi.json
# MCP_SEARCH_DEFAULT_LIMIT=10
# MCP_SEARCH_MAX_LIMIT=50
# MCP_SEARCH_QUERY_MAX=500
# MCP_LEADERBOARD_DEFAULT_LIMIT=20
# MCP_LEADERBOARD_MAX_LIMIT=100
# MCP_BATCH_MAX=20
# MCP_INVOCATION_ARGS_MAX=4096

# ─── Search tuning (defaults live in src/config.ts) ─────────────────────────
# SEARCH_FUSION_MODE=linear
# SEARCH_DEEP_ENABLED=false
# SEARCH_RERANKER_ENABLED=false
# SEARCH_DEFAULT_APPETITE=balanced
# SEARCH_CIRCUIT_BREAKER_THRESHOLD=3
# SEARCH_CIRCUIT_BREAKER_COOLDOWN_MS=30000
