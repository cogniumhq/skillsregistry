# SkillsRegistry Local — example env file.
# Copy to `.env` (or `.env.local`) and fill in the required values.
#
# Required:
DATABASE_URL=postgres://skillsregistry:skillsregistry@localhost:5432/skillsregistry
ADMIN_TOKEN=change-me-to-a-long-random-value

# HTTP (defaults shown):
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Postgres pool (defaults shown):
POSTGRES_POOL_MAX=10
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Embedder — `ollama` (default) or `upstream`.
EMBEDDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Upstream (optional — leave unset for air-gap mode).
# All three must be set together, or none.
# MOTHERSHIP_URL=https://api.skillsregistry.net
# MOTHERSHIP_API_KEY=sk_live_...
# TENANT_ID=your-tenant-id
# UPSTREAM_SEARCH_FALLBACK=true

# Logging (default `info`).
LOG_LEVEL=info
