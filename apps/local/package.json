{
  "name": "@skillsregistry/local",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hostable SkillsRegistry node. Runs on Node 22 + Postgres + Ollama.",
  "license": "Apache-2.0",
  "author": "Cognium Labs",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "skillsregistry-local": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm run build:web && tsc -p tsconfig.json",
    "build:web": "pnpm --filter @skillsregistry/local-web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node ./dist/index.js",
    "dev": "tsx watch src/index.ts",
    "web:dev": "pnpm --filter @skillsregistry/local-web run dev",
    "smoke:airgap": "./scripts/smoke-airgap.sh",
    "seed:eval": "tsx scripts/seed-eval.ts",
    "clean": "rm -rf dist .tsbuildinfo web/dist web/.astro"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@skillsregistry/contracts": "workspace:*",
    "@skillsregistry/dag": "workspace:*",
    "@skillsregistry/domain": "workspace:*",
    "@skillsregistry/eval": "workspace:*",
    "@skillsregistry/mcp": "workspace:*",
    "@skillsregistry/schema": "workspace:*",
    "hono": "^4.13.4",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
