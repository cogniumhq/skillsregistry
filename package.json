{
  "name": "skillsregistry-local",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source runtime + SDK for the SkillsRegistry ecosystem (Apache-2.0).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cogniumhq/skillsregistry-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/cogniumhq/skillsregistry-local.git"
  },
  "bugs": {
    "url": "https://github.com/cogniumhq/skillsregistry-local/issues"
  },
  "author": "Cognium Labs",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run --workspace ./vitest.workspace.ts",
    "test:coverage": "vitest run --workspace ./vitest.workspace.ts --coverage",
    "typecheck": "pnpm -r typecheck",
    "validate:listings": "node scripts/validate-listings.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "clean": "pnpm -r exec rm -rf dist .tsbuildinfo",
    "clean:deps": "pnpm -r exec rm -rf node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
