{
  "name": "@skillsregistry/contracts",
  "version": "1.0.0",
  "description": "Zod schemas + TypeScript types for the SkillsRegistry public API and the local-node ↔ mothership contract.",
  "license": "Apache-2.0",
  "author": "Cognium Labs",
  "homepage": "https://github.com/cogniumhq/skillsregistry-local/tree/main/packages/contracts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogniumhq/skillsregistry-local.git",
    "directory": "packages/contracts"
  },
  "bugs": "https://github.com/cogniumhq/skillsregistry-local/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./upstream": {
      "types": "./dist/upstream.d.ts",
      "import": "./dist/upstream.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./responses": {
      "types": "./dist/responses.d.ts",
      "import": "./dist/responses.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skillsregistry",
    "cognium",
    "zod",
    "openapi",
    "contracts"
  ]
}
