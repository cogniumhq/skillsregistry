{
  "name": "@skillsregistry/domain",
  "version": "1.0.0",
  "description": "Runtime-agnostic domain layer for SkillsRegistry — search intelligence, composition, resilience, scoring policy behind adapter interfaces.",
  "license": "Apache-2.0",
  "author": "Cognium Labs",
  "homepage": "https://github.com/cogniumhq/skillsregistry-local/tree/main/packages/domain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogniumhq/skillsregistry-local.git",
    "directory": "packages/domain"
  },
  "bugs": "https://github.com/cogniumhq/skillsregistry-local/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./resilience": {
      "types": "./dist/resilience/index.d.ts",
      "import": "./dist/resilience/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence/index.d.ts",
      "import": "./dist/intelligence/index.js"
    },
    "./scoring": {
      "types": "./dist/scoring/index.d.ts",
      "import": "./dist/scoring/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "import": "./dist/composition/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@skillsregistry/contracts": "workspace:*",
    "@skillsregistry/schema": "workspace:*",
    "nanoid": "^5.1.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skillsregistry",
    "cognium",
    "hexagonal",
    "adapters",
    "domain"
  ]
}
