{
  "name": "@skillsregistry/schema",
  "version": "1.2.0",
  "description": "Drizzle schema + migration runner for the SkillsRegistry data model. Runtime-agnostic (Node, Cloudflare Workers, edge).",
  "license": "Apache-2.0",
  "author": "Cognium Labs",
  "homepage": "https://github.com/cogniumhq/skillsregistry/tree/main/packages/schema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogniumhq/skillsregistry.git",
    "directory": "packages/schema"
  },
  "bugs": "https://github.com/cogniumhq/skillsregistry/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": "./dist/migrations/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-sql.mjs src/migrations dist/migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "pg": ">=8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skillsregistry",
    "cognium",
    "drizzle",
    "postgres",
    "pgvector",
    "migrations"
  ]
}
