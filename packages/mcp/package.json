{
  "name": "@skillsregistry/mcp",
  "version": "1.0.1",
  "description": "Framework-agnostic MCP (Model Context Protocol) surface for SkillsRegistry — JSON-RPC dispatch, tool schemas, discovery descriptor, invocation observability.",
  "license": "Apache-2.0",
  "author": "Cognium Labs",
  "homepage": "https://github.com/cogniumhq/skillsregistry-local/tree/main/packages/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogniumhq/skillsregistry-local.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/cogniumhq/skillsregistry-local/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js"
    },
    "./invocation-writer": {
      "types": "./dist/invocation-writer.d.ts",
      "import": "./dist/invocation-writer.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@skillsregistry/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skillsregistry",
    "cognium",
    "mcp",
    "model-context-protocol",
    "jsonrpc",
    "agent"
  ]
}
